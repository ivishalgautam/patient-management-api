# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001
HOST=localhost
# fatal|error|warn|info|debug|trace|silent (default: info in production, debug otherwise)
LOG_LEVEL=

# PostgreSQL
DB_DIALECT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=drdipti
PG_USERNAME=postgres
PG_PASSWORD=

# Test database (recreated on every `npm test`; name must contain "test")
TEST_PG_DATABASE=drdipti_test

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (jsonwebtoken format). Shorten ACCESS_TOKEN_TTL (e.g. 15m)
# once every client refreshes tokens on 401.
ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=30d
# Pre-revamp tokens (full user in payload) are accepted until this ISO date,
# e.g. 2026-11-15T00:00:00Z, so logged-in users are not kicked out on deploy.
LEGACY_TOKEN_GRACE_UNTIL=

# Generated patient passwords: random (default, shown once) or legacy
# (first 4 letters of name + last 4 digits of mobile; guessable).
PATIENT_PASSWORD_MODE=random

# Comma-separated allowed browser origins, e.g.
# https://dashboard.example.com,https://www.example.com
# Empty = allow any origin (logs a warning at boot).
ALLOWED_ORIGINS=

# Max upload size per file (MB)
MAX_UPLOAD_MB=100

# Global rate limit
MAX_RATE_LIMIT=300
TIME_WINDOW=1 minute

# Excel import defaults (legacy single-clinic import; removed once imports
# use the logged-in practice)
CLINIC_ID=
DOCTOR_ID=
DOCTOR_USER_ID=
PROCEDURE_ID=

# Wafly WhatsApp templates
WAFFLY_LICENSE=
WAFFLY_API_KEY=
WAFFLY_TEMPLATE_BOOKING_CONFIRM=
WAFFLY_TEMPLATE_24_HOURS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_2_HRS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_1_HR_AFTER_APPOINTMENT=
WAFFLY_TEMPLATE_REVIEW_MESAAGE=
