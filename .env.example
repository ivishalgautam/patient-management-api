# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001
HOST=localhost
# fatal|error|warn|info|debug|trace|silent (default: info in production, debug otherwise)
LOG_LEVEL=

# PostgreSQL
DB_DIALECT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=drdipti
PG_USERNAME=postgres
PG_PASSWORD=

# Test database (recreated on every `npm test`; name must contain "test")
TEST_PG_DATABASE=drdipti_test

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated allowed browser origins, e.g.
# https://dashboard.example.com,https://www.example.com
# Empty = allow any origin (logs a warning at boot).
ALLOWED_ORIGINS=

# Max upload size per file (MB)
MAX_UPLOAD_MB=100

# Global rate limit
MAX_RATE_LIMIT=300
TIME_WINDOW=1 minute

# Excel import defaults (legacy single-clinic import; removed once imports
# use the logged-in practice)
CLINIC_ID=
DOCTOR_ID=
DOCTOR_USER_ID=
PROCEDURE_ID=

# Wafly WhatsApp templates
WAFFLY_LICENSE=
WAFFLY_API_KEY=
WAFFLY_TEMPLATE_BOOKING_CONFIRM=
WAFFLY_TEMPLATE_24_HOURS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_2_HRS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_1_HR_AFTER_APPOINTMENT=
WAFFLY_TEMPLATE_REVIEW_MESAAGE=
