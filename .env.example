# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3001
HOST=localhost
# fatal|error|warn|info|debug|trace|silent (default: info in production, debug otherwise)
LOG_LEVEL=

# PostgreSQL
DB_DIALECT=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=drdipti
PG_USERNAME=postgres
PG_PASSWORD=
# Connection pool size
PG_POOL_MAX=20

# Only read by the tenancy migration (20261007000200): practice that owns
# patients with no clinic/doctor link, when more than one practice exists.
UNLINKED_PATIENT_PRACTICE_ID=

# Only read when rolling back the hardening migration while soft-deleted
# payments/ledger rows exist: true deletes them permanently.
FORCE_DROP_SOFT_DELETED=

# Test database (recreated on every `npm test`; name must contain "test")
TEST_PG_DATABASE=drdipti_test

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (jsonwebtoken format). Shorten ACCESS_TOKEN_TTL (e.g. 15m)
# once every client refreshes tokens on 401.
ACCESS_TOKEN_TTL=1d
REFRESH_TOKEN_TTL=30d
# Pre-revamp tokens (full user in payload) are accepted until this ISO date,
# e.g. 2026-11-15T00:00:00Z, so logged-in users are not kicked out on deploy.
LEGACY_TOKEN_GRACE_UNTIL=

# Role permissions. false = log denials instead of blocking (temporary
# rollback switch if a role turns out to be missing a permission).
PERMISSIONS_ENFORCE=true

# Appointment reminders: queue (pg-boss jobs with retries, default) or
# legacy (in-process 5-minute timer; rollback switch).
REMINDERS_ENGINE=queue

# Country used to parse phone numbers without a country code (lead dedupe)
DEFAULT_PHONE_REGION=IN

# Public URLs: the dashboard (form share links/embeds) and the API with /v1
# (webhook URLs shown to admins).
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/v1

# Lead forms: render-token signing key (default derives from JWT_SECRET) and
# optional Cloudflare Turnstile (enabled per form when both keys are set).
FORM_TOKEN_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lead integrations
# Key for stored integration tokens: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Days to keep encrypted raw webhook payloads (for replay)
INTEGRATION_PAYLOAD_RETENTION_DAYS=30
# Facebook / Instagram Lead Ads (Meta app with leads_retrieval). Webhook URL:
# <API_URL>/webhooks/facebook-leads ; OAuth redirect:
# <API_URL>/integrations/facebook/oauth/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v23.0
FB_PULL_SYNC_CRON=*/10 * * * *
# Google leads add-on (switched on per practice/clinic in Settings > Add-ons).
# Google Ads lead form webhook: <API_URL>/webhooks/google-ads/<token> plus the
# key chosen per integration (stored encrypted). Sheet/CSV import limits:
LEAD_IMPORT_MAX_ROWS=5000
LEAD_IMPORT_SHEET_MAX_MB=10

# Generated patient passwords: random (default, shown once) or legacy
# (first 4 letters of name + last 4 digits of mobile; guessable).
PATIENT_PASSWORD_MODE=random

# Comma-separated allowed browser origins, e.g.
# https://dashboard.example.com,https://www.example.com
# Empty = allow any origin (logs a warning at boot).
ALLOWED_ORIGINS=

# Max upload size per file (MB)
MAX_UPLOAD_MB=100

# Global rate limit
MAX_RATE_LIMIT=300
TIME_WINDOW=1 minute

# Excel import defaults (legacy single-clinic import; removed once imports
# use the logged-in practice)
CLINIC_ID=
DOCTOR_ID=
DOCTOR_USER_ID=
PROCEDURE_ID=

# Wafly WhatsApp templates
WAFFLY_LICENSE=
WAFFLY_API_KEY=
WAFFLY_TEMPLATE_BOOKING_CONFIRM=
WAFFLY_TEMPLATE_24_HOURS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_2_HRS_BEFORE_APPOINTMENT=
WAFFLY_TEMPLATE_1_HR_AFTER_APPOINTMENT=
WAFFLY_TEMPLATE_REVIEW_MESAAGE=
