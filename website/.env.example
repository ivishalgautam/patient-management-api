# The clinic dashboard ("Sign in" links go here).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Where this site is published (canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# Shown on the privacy policy, account deletion page and contact buttons.
# Google Play requires a working contact email on the privacy policy.
NEXT_PUBLIC_COMPANY_NAME=DentXCloud
NEXT_PUBLIC_CONTACT_EMAIL=
# With a phone number (international format, e.g. +91 98765 43210) "Book a demo" opens WhatsApp.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
